# YUGMIT — environment variables
# Copy to `.env` and fill with real values.
# Never commit a real `.env` file or any working key.
# All variables use the VITE_ prefix so Vite exposes them to the client build.

# Application
VITE_APP_NAME=YUGMIT

# Firebase — required for authentication and Firestore (Module 02+)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Firebase — optional but recommended
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Gemini (AI Problem Engine — Module 04)
# Google AI Studio free tier key. Client-side usage (not secret —
# see ARCHITECTURE.md for the disclosed V1 limitation).
VITE_GEMINI_API_KEY=

# Cloudinary — required for challenge evidence photo uploads (Module 03)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
