# YUGMIT — environment variables
# Copy to `.env` and fill with real values.
# Never commit a real `.env` file or any working key.
# All variables use the VITE_ prefix so Vite exposes them to the client build.

# Application
VITE_APP_NAME=YUGMIT

# Firebase — required for authentication and Firestore (Module 02+)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Firebase — optional but recommended
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# AI gateway (public endpoint URL only; no provider keys in this file)
# The Worker stores GEMINI_API_KEY and GROQ_API_KEY as Cloudflare secrets.
VITE_AI_GATEWAY_URL=

# Cloudinary — required for challenge evidence photo uploads (Module 03)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
